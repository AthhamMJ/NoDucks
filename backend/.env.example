PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/noducks
JWT_SECRET=your_jwt_secret_here
GEMINI_API_KEY=your_gemini_api_key_here
RESEND_API_KEY=your_resend_api_key_here

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=placeholder_cloud_name
CLOUDINARY_API_KEY=placeholder_api_key
CLOUDINARY_API_SECRET=placeholder_api_secret

# Visual Generation Provider (gemini | mock)
IMAGE_PROVIDER=gemini

# Feature Flags
IMAGE_GENERATION_ENABLED=false
